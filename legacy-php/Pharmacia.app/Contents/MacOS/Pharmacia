#!/bin/bash
set -euo pipefail

APP_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
PROJECT="$APP_DIR/PHARMACY"
LOG="${TMPDIR:-/tmp}/pharmacia-php.log"

if ! command -v php >/dev/null 2>&1; then
    if [[ -x /opt/homebrew/bin/php ]]; then
        PHP="/opt/homebrew/bin/php"
    else
        osascript -e 'display dialog "PHP is required. Install PHP and make the php command available on PATH." buttons {"OK"} with icon caution'
        exit 1
    fi
else
    PHP="$(command -v php)"
fi

if ! "$PHP" -m | grep -qi '^mysqli$'; then
    osascript -e 'display dialog "PHP must have the mysqli extension enabled." buttons {"OK"} with icon caution'
    exit 1
fi

if ! lsof -nP -iTCP:8000 -sTCP:LISTEN >/dev/null 2>&1; then
    (cd "$PROJECT" && nohup "$PHP" -S 127.0.0.1:8000 >"$LOG" 2>&1 </dev/null &)
fi

for _ in {1..20}; do
    if lsof -nP -iTCP:8000 -sTCP:LISTEN >/dev/null 2>&1; then
        open "http://127.0.0.1:8000/mainpage.php"
        exit 0
    fi
    sleep 0.5
done

osascript -e "display dialog \"PHP server did not start. Check $LOG\" buttons {\"OK\"} with icon caution"
exit 1
